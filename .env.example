# ==============================================================================
# RBAC AI Assistant — Template de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para `.env` e preencha os valores reais apenas localmente.
# NUNCA versione o arquivo `.env` no Git.

# --- Telegram Bot API ---
# Token obtido via @BotFather (use um bot separado para desenvolvimento/testes)
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# --- Google Gemini Developer API — Free Tier Standard (SDK oficial google-genai==3.6.1) ---
# Chave da Gemini Developer API gerada no Google AI Studio (mantenha vazia neste template).
# IMPORTANTE:
# 1) A assinatura pessoal Google AI Pro (usada no Antigravity para desenvolvimento) e a
#    Gemini Developer API usada por esta aplicação são serviços SEPARADOS.
# 2) Para permanecer no Free Tier sem cobranças, mantenha o projeto Google SEM Cloud Billing
#    vinculado (o código sozinho não consegue impedir cobranças se houver faturamento ativo).
# 3) No Free Tier, os prompts podem ser usados pela Google conforme os termos do serviço;
#    utilize apenas documentos públicos da ANAC e nunca envie dados pessoais ou confidenciais.
GEMINI_API_KEY=

# Política única do modelo de geração em runtime (Free Tier Standard): somente gemini-4-hydrogen (sem fallback)
GEMINI_GENERATION_MODEL=gemini-4-hydrogen

# Política única do modelo de embeddings em runtime (Free Tier Standard): somente gemini-embedding-2 com 768 dimensões
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Trava obrigatória Free Tier (bloqueia modelos pagos como neon/carbon/argon e alternativas não autorizadas)
GEMINI_ALLOW_PAID_MODELS=false

# --- ChromaDB (Servidor em container independente na rede interna Docker) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- Ambiente e Observabilidade ---
# Valores esperados: local | production
ENVIRONMENT=local
# Valores esperados: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
