# ==============================================================================
# RBAC AI Assistant — Template de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para `.env` e preencha os valores reais apenas localmente.
# NUNCA versione o arquivo `.env` no Git.

# --- Telegram Bot API ---
# Token obtido via @BotFather (use um bot separado para desenvolvimento/testes)
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# --- Google Gemini API (SDK oficial google-genai==3.6.1) ---
# Chave de API gerada no Google AI Studio ou Google Cloud Project (deixe vazia no template).
# ATENÇÃO: Assinatura pessoal do Gemini ou Antigravity NÃO inclui automaticamente faturamento
# da Gemini API por chave. O modelo padrão `gemini-4-neon` exige tier pago (US$ 3 / US$ 15
# por 1M de tokens). Para testes de menor custo ou free tier, use `gemini-4-hydrogen`.
GEMINI_API_KEY=

# Variável canônica do modelo de geração (estável: gemini-4-neon; alternativas: gemini-4-hydrogen, gemini-4-carbon)
GEMINI_GENERATION_MODEL=gemini-4-neon

# Modelo de embeddings multimodal estável (8.192 tokens; MRL 128-3072, recomendadas: 768, 1536, 3072)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# --- ChromaDB (Servidor em container independente na rede interna Docker) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- Ambiente e Observabilidade ---
# Valores esperados: local | production
ENVIRONMENT=local
# Valores esperados: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
